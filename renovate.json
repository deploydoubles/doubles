{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Patch and minor updates merge themselves once conformance is green.",
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major updates (a new framework major usually needs code changes) wait for a human.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
