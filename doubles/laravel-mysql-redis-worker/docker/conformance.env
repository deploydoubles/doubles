# Settings for the conformance run, mounted as the app's .env file — the way
# most PHP hosts deliver them. Nothing here is a secret: a throwaway key for a
# throwaway app, and credentials for a database that only lives in Compose.
APP_NAME=laravel-mysql-redis-worker
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:ZGVwbG95ZG91Ymxlcy1jb25mb3JtYW5jZS1vbmx5ISE=
LOG_CHANNEL=stderr

# URL style for the database...
DB_CONNECTION=mysql
DATABASE_URL=mysql://double:double@mysql:3306/double

# ...and discrete variables for Redis: the double accepts both.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
