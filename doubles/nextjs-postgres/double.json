{
  "$schema": "https://deploydoubles.dev/schema/manifest-v0.1.json",
  "spec_version": "0.1",
  "id": "nextjs-postgres",
  "description": "Next.js (App Router) with Postgres; checks run in-process on a timer started from instrumentation.ts.",
  "framework": { "name": "next", "version": "^16.3" },
  "runtime": { "name": "node", "version": ">=24" },
  "services": { "database": "postgres" },
  "processes": {
    "web": { "command": "npm start" }
  },
  "env": { "required": ["NODE_ENV"] },
  "build": ["npm ci", "npm run build"],
  "release": [],
  "persistent_paths": ["storage"],
  "expects": {
    "inside": ["database", "scheduler", "scheduler.release", "storage", "env"],
    "outside": ["reachability", "tls", "https_redirect", "release", "run_id", "downtime", "rollback", "persistence", "detection"]
  },
  "failure_modes": []
}
