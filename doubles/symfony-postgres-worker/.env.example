# What this app reads from its environment. A platform generates APP_SECRET
# and provides the database, as a URL (DATABASE_URL) or as discrete DB_*
# variables. Copy to .env for a local run; never commit .env.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=

# Either a URL...
DATABASE_URL=
# ...or discrete variables (used only when DATABASE_URL is empty).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=double
DB_USERNAME=double
DB_PASSWORD=

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Optional, per deploy: the verifier's --run-id value.
DEPLOY_RUN_ID=
