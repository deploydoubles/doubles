{
  "$schema": "https://deploydoubles.dev/schema/manifest-v0.1.json",
  "spec_version": "0.1",
  "id": "symfony-postgres-worker",
  "description": "Symfony with Postgres, a Messenger worker on the Doctrine transport, and a console command run every minute by cron.",
  "framework": { "name": "symfony", "version": "8.1.*" },
  "runtime": { "name": "php", "version": ">=8.4" },
  "services": { "database": "postgres", "queue": "database" },
  "processes": {
    "web": { "command": "php -S 0.0.0.0:8080 -t public public/index.php" },
    "worker": { "command": "php bin/console messenger:consume async" },
    "scheduler": { "command": "php bin/console deploy-report:run" }
  },
  "env": { "required": ["APP_SECRET"], "generated": ["APP_SECRET"] },
  "build": ["composer install --no-dev --optimize-autoloader"],
  "release": ["php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration"],
  "expects": {
    "inside": ["database", "queue", "queue.release", "scheduler", "scheduler.release", "storage", "env"],
    "outside": ["reachability", "tls", "https_redirect", "release", "run_id", "downtime", "rollback", "persistence", "detection"]
  },
  "failure_modes": []
}
