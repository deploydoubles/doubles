{
  "$schema": "https://deploydoubles.dev/schema/manifest-v0.1.json",
  "spec_version": "0.1",
  "id": "php-mysql",
  "description": "Plain PHP without a framework, with MySQL and one cron job; no queue.",
  "framework": { "name": "none", "version": "*" },
  "runtime": { "name": "php", "version": ">=8.3" },
  "services": { "database": "mysql" },
  "processes": {
    "web": { "command": "php -S 0.0.0.0:8080 -t public public/index.php" },
    "scheduler": { "command": "php vendor/bin/deploy-report-run" }
  },
  "env": { "required": ["APP_ENV"] },
  "build": ["composer install --no-dev --optimize-autoloader"],
  "release": [],
  "expects": {
    "inside": ["database", "scheduler", "scheduler.release", "storage", "env"],
    "outside": ["reachability", "tls", "https_redirect", "release", "run_id", "downtime", "rollback", "persistence", "detection"]
  },
  "failure_modes": []
}
