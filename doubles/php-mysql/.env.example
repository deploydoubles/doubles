# What this app reads from its environment (or from a .env file in the app
# root, which real environment variables override). Never commit .env.
APP_ENV=production

# Either a URL...
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/double
# ...or discrete variables.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=double
DB_USERNAME=double
DB_PASSWORD=

# Optional, per deploy: the verifier's --run-id value.
DEPLOY_RUN_ID=
