#!/usr/bin/env php
<?php

/*
 * Runs the deploy report checks once and stores the results. Call it every
 * minute from cron, from the app root:
 *
 *   * * * * * cd /path/to/app && php vendor/bin/deploy-report-run
 */

declare(strict_types=1);

$autoload = $GLOBALS['_composer_autoload_path'] ?? null;
foreach ([$autoload, __DIR__.'/../../../autoload.php', __DIR__.'/../vendor/autoload.php'] as $candidate) {
    if (is_string($candidate) && is_file($candidate)) {
        require $candidate;
        break;
    }
}

if (! function_exists('DeployDoubles\Checks\run')) {
    fwrite(STDERR, "deploy-report-run: run composer install first\n");
    exit(1);
}

exit(DeployDoubles\Checks\run(output: static fn (string $line) => print($line.PHP_EOL)));
